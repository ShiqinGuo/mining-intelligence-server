        "Authorization": "Bearer ${MINING_SERVICE_TOKEN}"
      }
    },
    "mining-market": {
      "type": "http",
      "url": "http://127.0.0.1:28111/mcp/market/",
      "headers": {
        "Authorization": "Bearer ${MINING_SERVICE_TOKEN}"
      }
    }
  }
}
