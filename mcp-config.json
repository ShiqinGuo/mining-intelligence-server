{
  "mcpServers": {
    "mining-news": {
      "type": "http",
      "url": "http://127.0.0.1:28111/mcp/news/",
      "headers": {
        "Authorization": "Bearer ${MINING_SERVICE_TOKEN}"
      }
    },
    "mining-documents": {
      "type": "http",
      "url": "http://127.0.0.1:28111/mcp/documents/",
